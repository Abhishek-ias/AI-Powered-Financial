# AI Financial Journey Copilot — Backend Environment Configuration
# Copy to .env and fill in values for production (e.g. Render / Railway)

# Server & Runtime
PORT=3000
NODE_ENV=production

# Frontend Origin for CORS (set to your Vercel deployment URL)
# Example: https://ai-powered-financial.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Database (SQLite default for demo; PostgreSQL optional for external DB)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/financial_copilot?schema=public"

# Azure OpenAI (Set to true if providing live Azure OpenAI service)
ENABLE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Document Intelligence
ENABLE_AZURE_DOCUMENT_INTELLIGENCE=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your-api-key-here

# Azure AI Search
ENABLE_AZURE_SEARCH=false
AZURE_SEARCH_ENDPOINT=https://your-resource.search.windows.net
AZURE_SEARCH_API_KEY=your-api-key-here
AZURE_SEARCH_INDEX=policies

# Cognee
ENABLE_COGNEE=false
COGNEE_API_URL=http://localhost:8000
COGNEE_API_KEY=your-api-key-here

# n8n Workflow Automation
ENABLE_N8N=false
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-api-key-here

# Domain Feature Flags
ENABLE_LENDING=true
ENABLE_FINTECH=true
ENABLE_CROSS_DOMAIN=false
ENABLE_VOICE=false
ENABLE_MULTILINGUAL=false
ENABLE_PROACTIVE=false
ENABLE_FRAUD=false

# Mock / Sandbox Providers (Ensures 100% functionality without paid external services)
USE_MOCK_DOCUMENT_AI=true
USE_MOCK_SEARCH=true
USE_MOCK_MEMORY=true
USE_MOCK_WORKFLOW=true
MOCK_INSURER=true
MOCK_LENDER=true
MOCK_FINTECH=true

# Upload Configuration
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads

# Authentication Secret
JWT_SECRET=your-secure-random-jwt-secret-here
